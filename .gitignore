_build/
rebar3.crashdump
erl_crash.dump
*.beam

# fprof's raw trace dump (fprof:profile/0 writes it to the cwd by
# default) — tens of MB of binary data from a single profiling run
# (docs/benchmarking.md), never meant to be committed.
fprof.trace

# C build artifacts under c_src/ (and anywhere else) — always regenerated
# by rebar3's `pc` port-compiler plugin, never meant to be committed.
*.o
*.a
*.so
*.dylib
*.d
tree-sitter.pc

# Derived Prolog fact database — deterministic rebuild from source via
# `symbolic parse`, not something to version (docs/prolog-store.md §7).
.pi/facts.dets

# Regenerated on every build by scripts/gen_git_sha.sh (rebar.config
# pre_hook) — the running commit's SHA, not something to version.
priv/git_sha

# The Pelican site (website/) is rebuilt from website/content each time;
# its output is a build artifact like _build/ above, not something to
# version. pipenv keeps the virtualenv itself outside the repo by
# default, so there's no local venv/ dir here to ignore.
website/output/
website/cache/
