_build/
rebar3.crashdump
erl_crash.dump
*.beam

# fprof's raw trace dump (fprof:profile/0 writes it to the cwd by
# default) — tens of MB of binary data from a single profiling run
# (docs/benchmarking.md), never meant to be committed.
fprof.trace

# C build artifacts under c_src/ (and anywhere else) — always regenerated
# (cargo/cc build them under native/symbolic_ts/target now; the old
# rebar3 `pc` plugin produced these directly under c_src/), never meant
# to be committed.
*.o
*.a
*.so
*.dylib
*.d
tree-sitter.pc

# Derived Prolog fact database — deterministic rebuild from source via
# `symbolic parse`, not something to version (docs/prolog-store.md §7).
.pi/facts.dets

# Regenerated on every build by scripts/gen_git_sha.sh (rebar.config
# pre_hook) — the running commit's SHA, not something to version.
priv/git_sha

# The Pelican site (website/) is rebuilt from website/content each time;
# its output is a build artifact like _build/ above, not something to
# version. pipenv keeps the virtualenv itself outside the repo by
# default, so there's no local venv/ dir here to ignore.
website/output/
website/cache/

# Rust build artifacts (the symbolic_ts Rustler NIF crate) — cargo
# regenerates them; scripts/build_nif.sh copies the one artifact that
# matters into priv/.
# Cargo build artifacts for every native/* crate — was previously
# listed per-crate (native/symbolic_ts/target/), which let a newly
# added crate's artifacts land unignored (staged by accident once).
native/*/target/

# Built slide decks (Justfile `build-presentations`) — one portable HTML
# file per docs/presentations/*.md, regenerated from source, not versioned.
docs/presentations/*.html

# promptfoo eval output (evals/README.md regenerates it on every run) —
# per-run JSON tables, never meant to be committed.
evals/mcp-output.json
evals/iterate-output.json
