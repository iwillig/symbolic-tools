{erl_opts, [debug_info]}.

{deps, [
    {erlog, {git, "https://github.com/rvirding/erlog.git", {branch, "develop"}}},
    {erlmcp, "0.5.1"}
]}.

%% The tree-sitter NIF (symbolic_ts, c_src/symbolic_ts_nif.c) used to be
%% a vendored fork of a separate dependency (erl_ts, at _checkouts/erl_ts)
%% wrapping close to the entire tree-sitter C API. This project only ever
%% called ~20 of its functions, and the fork being untracked in git
%% (deliberately, to keep it out of this repo) turned out to actively
%% block packaging: a fresh `git clone` had no fork to build against at
%% all. Inlined instead — see docs/tree-sitter-erlang.md §2 — as our own
%% small, purpose-built NIF, built via the standard rebar3 `pc` (port
%% compiler) plugin below, not a hand-rolled Makefile.
{plugins, [pc]}.
{provider_hooks, [
    {post, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{port_specs, [
    {"priv/symbolic_ts.so", [
        "c_src/symbolic_ts_nif.c",
        "c_src/tree-sitter/src/lib.c",
        "c_src/grammars/erlang/parser.c",
        "c_src/grammars/erlang/scanner.c",
        "c_src/grammars/typescript/parser.c",
        "c_src/grammars/typescript/scanner.c",
        "c_src/grammars/markdown/parser.c",
        "c_src/grammars/markdown/scanner.c",
        "c_src/grammars/toml/parser.c",
        "c_src/grammars/toml/scanner.c",
        "c_src/grammars/json/parser.c"
    ]}
]}.

%% -D_POSIX_C_SOURCE=200112L -D_DEFAULT_SOURCE matter specifically on
%% Linux, confirmed by a real CI failure, not guessed: c_src/tree-
%% sitter/src/unicode.h includes its own portable/endian.h, which on
%% Linux just does `#include <endian.h>` and defers to glibc — but
%% glibc only actually *declares* le16toh/be16toh/etc. when one of
%% these feature-test macros is defined. Without them, the compiler
%% implicitly declares le16toh as an external function (a warning, not
%% a build error, since it's still just a shared-object link), but no
%% such symbol exists anywhere at runtime — glibc's real implementation
%% is header-only — so the NIF fails to `dlopen` at load time with
%% "undefined symbol: le16toh", not at compile time. Upstream
%% tree-sitter's own Makefile sets exactly these two flags for exactly
%% this reason; lost when this project's build moved off that Makefile
%% onto the `pc` plugin.
{port_env, [
    {"CFLAGS", "$CFLAGS -std=c11 -D_POSIX_C_SOURCE=200112L -D_DEFAULT_SOURCE "
               "-Ic_src/tree-sitter/include "
               "-Ic_src/grammars/erlang -Ic_src/grammars/typescript "
               "-Ic_src/grammars/markdown -Ic_src/grammars/toml "
               "-Ic_src/grammars/json"}
]}.

%% erlmcp 0.5.1 fails to compile on OTP 29: it uses the prefix `catch Expr`
%% form, deprecated in OTP 29. Confirmed by testing, not assumed: this is
%% NOT a `warnings_as_errors` issue (erlmcp's own erl_opts don't set it,
%% and overriding erl_opts to just `[debug_info]` — removing any
%% possibility of it — still failed identically). OTP 29 apparently
%% escalates this specific deprecation to a hard error on its own. The
%% fix is the compile directive named right in the warning text:
%% `nowarn_deprecated_catch`, added via a rebar3 `overrides` entry for
%% just this dependency. Unlike the erl_ts overrides attempt earlier
%% (which touched pre_hooks and made things worse), this is a normal,
%% supported use of `overrides` — only affects compiler strictness, not
%% build/hook behavior.
{overrides, [
    {override, erlmcp, [
        {erl_opts, [debug_info, nowarn_deprecated_catch]}
    ]}
]}.

{escript_main_app, symbolic_tools}.
{escript_name, "symbolic"}.
%% symbolic_ts's priv/*.so is deliberately NOT embedded here:
%% `escript_incl_apps` bundles only .beam/.app files into the escript's
%% zip archive, never `priv/`, and a NIF (`erlang:load_nif/2`) cannot
%% dlopen a shared library from inside a zip archive at all.
%% `symbolic_parse` checks for this explicitly and fails with a clear
%% message instead. See docs/cli-erlang.md and docs/tree-sitter-erlang.md
%% for the real fix (a `rebar3 release`, where `priv/` stays real files
%% on disk).
{escript_incl_apps, [erlog]}.
{escript_emu_args, "%%! -escript main symbolic_cli\n"}.

%% A release, not just an escript: the NIF needs priv/ kept as real
%% files on disk, which escript's zip archive can't provide. See
%% docs/cli-erlang.md §1/§1.1.
%%
%% dev_mode is false, not the dev-friendly default, because this release
%% has to be relocatable for Homebrew packaging (see Formula/symbolic-
%% tools.rb): confirmed by testing directly that dev_mode:true makes relx
%% symlink every app dir (lib/erlog-*, lib/symbolic_tools-*, ...) back
%% into this exact checkout's _build/ tree, rather than copying real
%% files — harmless for local development, but it means the built
%% release cannot survive being copied anywhere else, let alone into a
%% Homebrew Cellar path assembled in a throwaway build sandbox.
%% include_erts stays false — a Homebrew formula declares `depends_on
%% "erlang"`, so the release can keep calling out to a real `erl` on
%% PATH instead of embedding its own copy of the runtime.
%%
%% sasl is included because `symbolic serve` (the MCP server,
%% docs/erlang-mcp-design.md) is a long-running node, unlike the one-shot
%% CLI commands — sasl is what makes a release upgradeable in place
%% (release_handler, .appup/relup) rather than requiring a full restart to
%% deploy a new version. Not needed for `parse`/`query` themselves, but
%% cheap to have from the start rather than retrofit once `serve` exists.
%%
%% symbolic_ts (the tree-sitter NIF) isn't listed separately — it lives
%% inside the symbolic_tools app itself now, not a standalone dependency.
{relx, [
    {release, {symbolic_tools, "0.1.0"}, [sasl, erlog, erlmcp, symbolic_tools]},
    {dev_mode, false},
    {include_erts, false},
    {extended_start_script, true},
    %% relx's own generated bin/symbolic_tools manages a long-running node
    %% (start/stop/console/rpc) — its `eval`/`escript` subcommands both
    %% require a node already running, so they don't fit a one-shot CLI.
    %% scripts/symbolic is our own wrapper for that; copy it in as bin/symbolic.
    {overlay, [
        {copy, "scripts/symbolic", "bin/symbolic"}
    ]}
]}.

{profiles, [
    {test, [
        {eunit_opts, [verbose]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_opts, [verbose]}.
