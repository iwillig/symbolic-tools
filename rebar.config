{erl_opts, [debug_info]}.

%% erl_ts is a local, vendored fork, at _checkouts/erl_ts. Adding
%% TypeScript support required editing its C source and Makefiles
%% directly (see docs/tree-sitter-erlang.md §5), which a plain git
%% dependency can't accommodate, and rebar3 has no real `{path, Dir}`
%% dependency source (confirmed: it errors with "Failed to fetch and copy
%% dep" — that tuple form isn't a thing rebar3 supports, despite looking
%% like it should be). `_checkouts/` (leading underscore) is rebar3's
%% real mechanism for developing against a local copy instead of the
%% fetched one — but confirmed empirically, it OVERRIDES a `deps` entry,
%% it doesn't replace needing one: with no `deps` entry for erl_ts at
%% all, `_checkouts/erl_ts` compiled (harmless — Erlang doesn't check
%% remote-module calls at compile time) but was never added to any
%% runtime code path, so every NIF call failed `undef`. The git dep below
%% is therefore still required — it's what tells rebar3 "erl_ts is a real
%% dependency, put it on the path" — but it's never actually fetched from,
%% since `_checkouts/erl_ts` (this repo's own fork) always takes
%% precedence when present.
{deps, [
    {erlog, {git, "https://github.com/rvirding/erlog.git", {branch, "develop"}}},
    {erl_ts, {git, "https://github.com/cfclavijo/erl_ts.git", {branch, "master"}}},
    {erlmcp, "0.5.1"}
]}.

%% erlmcp 0.5.1 fails to compile on OTP 29: it uses the prefix `catch Expr`
%% form, deprecated in OTP 29. Confirmed by testing, not assumed: this is
%% NOT a `warnings_as_errors` issue (erlmcp's own erl_opts don't set it,
%% and overriding erl_opts to just `[debug_info]` — removing any
%% possibility of it — still failed identically). OTP 29 apparently
%% escalates this specific deprecation to a hard error on its own. The
%% fix is the compile directive named right in the warning text:
%% `nowarn_deprecated_catch`, added via a rebar3 `overrides` entry for
%% just this dependency. Unlike the erl_ts overrides attempt earlier
%% (which touched pre_hooks and made things worse), this is a normal,
%% supported use of `overrides` — only affects compiler strictness, not
%% build/hook behavior.
{overrides, [
    {override, erlmcp, [
        {erl_opts, [debug_info, nowarn_deprecated_catch]}
    ]}
]}.

{escript_main_app, symbolic_tools}.
{escript_name, "symbolic"}.
%% erl_ts is deliberately NOT embedded here: `escript_incl_apps` bundles
%% only .beam/.app files into the escript's zip archive, never `priv/`,
%% and a NIF (`erlang:load_nif/2`) cannot dlopen a shared library from
%% inside a zip archive at all. Embedding erl_ts's .beam without its .so
%% produced a silent, broken copy (an "undefined function" crash at
%% runtime) — worse than not embedding it. `symbolic_parse` checks for
%% this explicitly and fails with a clear message instead. See
%% docs/cli-erlang.md and docs/tree-sitter-erlang.md for the real fix
%% (a `rebar3 release`, where `priv/` stays real files on disk).
{escript_incl_apps, [erlog]}.
{escript_emu_args, "%%! -escript main symbolic_cli\n"}.

%% checkouts apps (erl_ts) skip their own rebar.config's pre_hooks/post_hooks
%% entirely — confirmed empirically: rebar3 only compiles a checkout app's
%% .erl -> .beam automatically, never runs its Makefile. checkouts apps
%% also never get copied to _build/default/lib/ — they stay and are built
%% in place at _checkouts/erl_ts. So our own top-level pre_hooks builds
%% erl_ts's C parts directly, and the post_hooks below target
%% _checkouts/erl_ts/priv/, not _build/default/lib/erl_ts/priv/.
{pre_hooks, [
    {"(darwin|linux)", compile, "make -C _checkouts/erl_ts"}
]}.

%% erl_ts's own build (c_src/Makefile) bakes in wrong install-name paths
%% on macOS: /usr/local/lib/libtree-sitter.0.25.dylib (never installed
%% there), /libtree-sitter-erlang.dylib, and (added for TypeScript support)
%% /libtree-sitter-typescript.dylib — all filesystem-root paths, a build
%% bug upstream. Fix: copy the real .dylib files into erl_ts's own priv/
%% dir (as siblings of erl_ts.so) and repoint the install names at those
%% siblings via @loader_path. Keeping the dylibs inside priv/ means
%% whatever copies priv/ (a `rebar3 release`) keeps everything the NIF
%% needs together as one unit. See docs/tree-sitter-erlang.md §6.1.
%% NOTE: chaining multiple shell commands in one hook string (with && or
%% ;) was tried and is unreliable here — only the first command reliably
%% ran, silently, with no error surfaced. Each hook below is a single
%% command, as separate list entries, which does work.
{post_hooks, [
    {"(darwin)", compile,
        "cp _checkouts/erl_ts/tree-sitter/libtree-sitter.dylib "
        "_checkouts/erl_ts/tree-sitter-langs/libtree-sitter-erlang.dylib "
        "_checkouts/erl_ts/tree-sitter-langs/libtree-sitter-typescript.dylib "
        "_checkouts/erl_ts/priv/"},
    {"(darwin)", compile,
        "install_name_tool "
        "-change /usr/local/lib/libtree-sitter.0.25.dylib @loader_path/libtree-sitter.dylib "
        "-change /libtree-sitter-erlang.dylib @loader_path/libtree-sitter-erlang.dylib "
        "-change /libtree-sitter-typescript.dylib @loader_path/libtree-sitter-typescript.dylib "
        "_checkouts/erl_ts/priv/erl_ts.so"}
]}.

%% A release, not just an escript: NIFs (erl_ts) need priv/ kept as real
%% files on disk, which escript's zip archive can't provide. See
%% docs/cli-erlang.md §1/§1.1. dev_mode/include_erts are dev-friendly
%% (fast, symlinked, host-ERTS) for now — flip both for an actually
%% shippable/portable release later.
%%
%% sasl is included because `symbolic serve` (the MCP server,
%% docs/erlang-mcp-design.md) is a long-running node, unlike the one-shot
%% CLI commands — sasl is what makes a release upgradeable in place
%% (release_handler, .appup/relup) rather than requiring a full restart to
%% deploy a new version. Not needed for `parse`/`query` themselves, but
%% cheap to have from the start rather than retrofit once `serve` exists.
{relx, [
    {release, {symbolic_tools, "0.1.0"}, [sasl, erlog, erl_ts, erlmcp, symbolic_tools]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    %% relx's own generated bin/symbolic_tools manages a long-running node
    %% (start/stop/console/rpc) — its `eval`/`escript` subcommands both
    %% require a node already running, so they don't fit a one-shot CLI.
    %% scripts/symbolic is our own wrapper for that; copy it in as bin/symbolic.
    {overlay, [
        {copy, "scripts/symbolic", "bin/symbolic"}
    ]}
]}.

{profiles, [
    {test, [
        {eunit_opts, [verbose]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_opts, [verbose]}.
