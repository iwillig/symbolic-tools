{erl_opts, [debug_info]}.

%% Stamps priv/git_sha with the current commit before every compile, so
%% the running server can report which build it is (see `git_sha` on
%% `parse`/`overview`, wired in symbolic_version.erl) — the tell for
%% "has this long-running MCP node actually picked up my rebuild yet."
{pre_hooks, [
    {compile, "scripts/gen_git_sha.sh"},
    %% Builds the Rustler NIF (native/symbolic_ts) into priv/symbolic_ts.so
    %% before any beam that would load it — rebar3 runs both compile
    %% pre-hooks for this provider, in list order (verified directly by
    %% building with a stale priv/symbolic_ts.so and watching both run).
    {compile, "scripts/build_nif.sh"}
]}.

{post_hooks, [
    {clean, "rm -f priv/symbolic_ts.so priv/symbolic_text.so"}
]}.

{deps, [
    {erlog, {git, "https://github.com/rvirding/erlog.git", {branch, "develop"}}},
    {erlmcp, "0.5.1"},
    %% Already pulled in transitively (erlmcp -> jesse -> jsx); declared
    %% directly here now that symbolic_term_json.erl calls it, so it
    %% doesn't silently disappear if erlmcp's own dependency on it ever
    %% changes.
    {jsx, "3.1.0"},
    %% Native Erlang/OTP runtime for llama.cpp — the open-vocabulary
    %% extraction tier (src/symbolic_extract_llm.erl, still to be
    %% written), see docs/reviewing-llm-output.md §4/§4.2. Requires a
    %% C++17 toolchain and cmake >=3.20 (Brewfile) to build its vendored
    %% llama.cpp on first compile. Supersedes barrel_inference, now
    %% archived — verified directly, not assumed (§4).
    {erllama, "0.11.0"}
]}.

%% The tree-sitter NIF (symbolic_ts, priv/symbolic_ts.so) is a Rustler
%% crate: native/symbolic_ts, built by scripts/build_nif.sh via the
%% compile pre-hook above. History: it started as a vendored fork of the
%% erl_ts dependency (_checkouts/erl_ts, untracked, which blocked
%% packaging); was inlined as a small purpose-built C NIF built via the
%% rebar3 `pc` plugin (c_src/symbolic_ts_nif.c — see git history and
%% docs/tree-sitter-erlang.md); and was then ported to Rust because the
%% two crashes that C NIF's own comments documented (a use-after-free
%% that made free_tree a deliberate leak, and a null-node deref) are
%% exactly what Rust's ownership model encodes: every NodeRes pins a
%% ResourceArc of its TreeRes, null nodes are a type-level Option, the
%% two long-running NIFs are DirtyCpu-scheduled, and source input is a
%% real UTF-8 binary (the C NIF's enif_get_string ERL_NIF_LATIN1 silently
%% truncated codepoints > 255, misaligning byte offsets for non-Latin-1
%% files). The Rust build.rs compiles the SAME vendored tree-sitter core
%% and grammars (c_src/tree-sitter, c_src/grammars) the pc build did, via
%% the cc crate, with the same -std=c11 -D_POSIX_C_SOURCE=200112L
%% -D_DEFAULT_SOURCE flags the {port_env} below used to carry (see
%% native/symbolic_ts/build.rs for why those flags matter on Linux), so
%% the fact base is byte-identical — verified by the fact-parity gate,
%% scripts/parity_check.sh.
%%
%% A second Rustler crate, native/symbolic_text (priv/symbolic_text.so),
%% carries the full-text search tier: a hand-built BM25 inverted index
%% over unicode-segmentation's UAX #29 word tokens — zero-model,
%% deterministic. Stack decision and rejected alternatives (tantivy,
%% charabia, stemming) recorded in docs/full-text-search.md; built by
%% the same scripts/build_nif.sh pre-hook.
%%
%% Requires a Rust toolchain (cargo on PATH, or brew install rust). No
%% rebar3 plugin involved: pc is gone, and cargo is invoked directly by
%% the hook script.

%% erlmcp 0.5.1 fails to compile on OTP 29: it uses the prefix `catch Expr`
%% form, deprecated in OTP 29. Confirmed by testing, not assumed: this is
%% NOT a `warnings_as_errors` issue (erlmcp's own erl_opts don't set it,
%% and overriding erl_opts to just `[debug_info]` — removing any
%% possibility of it — still failed identically). OTP 29 apparently
%% escalates this specific deprecation to a hard error on its own. The
%% fix is the compile directive named right in the warning text:
%% `nowarn_deprecated_catch`, added via a rebar3 `overrides` entry for
%% just this dependency. Unlike the erl_ts overrides attempt earlier
%% (which touched pre_hooks and made things worse), this is a normal,
%% supported use of `overrides` — only affects compiler strictness, not
%% build/hook behavior.
{overrides, [
    {override, erlmcp, [
        {erl_opts, [debug_info, nowarn_deprecated_catch]}
    ]}
]}.

{escript_main_app, symbolic_tools}.
{escript_name, "symbolic"}.
%% symbolic_ts's priv/*.so is deliberately NOT embedded here:
%% `escript_incl_apps` bundles only .beam/.app files into the escript's
%% zip archive, never `priv/`, and a NIF (`erlang:load_nif/2`) cannot
%% dlopen a shared library from inside a zip archive at all.
%% `symbolic_parse` checks for this explicitly and fails with a clear
%% message instead. See docs/cli-erlang.md and docs/tree-sitter-erlang.md
%% for the real fix (a `rebar3 release`, where `priv/` stays real files
%% on disk).
{escript_incl_apps, [erlog]}.
{escript_emu_args, "%%! -escript main symbolic_cli\n"}.

%% A release, not just an escript: the NIF needs priv/ kept as real
%% files on disk, which escript's zip archive can't provide. See
%% docs/cli-erlang.md §1/§1.1.
%%
%% dev_mode is false, not the dev-friendly default, because this release
%% has to be relocatable for Homebrew packaging (see Formula/symbolic-
%% tools.rb): confirmed by testing directly that dev_mode:true makes relx
%% symlink every app dir (lib/erlog-*, lib/symbolic_tools-*, ...) back
%% into this exact checkout's _build/ tree, rather than copying real
%% files — harmless for local development, but it means the built
%% release cannot survive being copied anywhere else, let alone into a
%% Homebrew Cellar path assembled in a throwaway build sandbox.
%% include_erts stays false — a Homebrew formula declares `depends_on
%% "erlang"`, so the release can keep calling out to a real `erl` on
%% PATH instead of embedding its own copy of the runtime.
%%
%% sasl is included because `symbolic serve` (the MCP server,
%% docs/erlang-mcp-design.md) is a long-running node, unlike the one-shot
%% CLI commands — sasl is what makes a release upgradeable in place
%% (release_handler, .appup/relup) rather than requiring a full restart to
%% deploy a new version. Not needed for `parse`/`query` themselves, but
%% cheap to have from the start rather than retrofit once `serve` exists.
%%
%% symbolic_ts (the tree-sitter NIF) isn't listed separately — it lives
%% inside the symbolic_tools app itself now, not a standalone dependency.
{relx, [
    {release, {symbolic_tools, "0.2.0"}, [sasl, erlog, erlmcp, symbolic_tools]},
    {dev_mode, false},
    {include_erts, false},
    {extended_start_script, true},
    %% relx's own generated bin/symbolic_tools manages a long-running node
    %% (start/stop/console/rpc) — its `eval`/`escript` subcommands both
    %% require a node already running, so they don't fit a one-shot CLI.
    %% scripts/symbolic is our own wrapper for that; copy it in as bin/symbolic.
    {overlay, [
        {copy, "scripts/symbolic", "bin/symbolic"}
    ]}
]}.

{profiles, [
    {test, [
        {eunit_opts, [verbose]},
        %% Test-only: the CLI dispatch handlers in symbolic_cli.erl call
        %% straight into symbolic_query:run/3, symbolic_parse:run/2, and
        %% symbolic_serve:run/0, all of which halt() or run forever —
        %% meck is the only safe way to exercise the argument-passing
        %% logic without invoking those directly. See docs/testing-erlang.md §5.2.
        {deps, [meck]}
    ]},
    %% Benchmark-only: erlperf (https://www.erlang.org/doc/system/benchmarking.html
    %% is the official docs' own recommended tool) is a real dependency with its
    %% own runtime footprint, so it's scoped to this profile rather than the
    %% main deps list — it has no reason to ship in the CLI/MCP release. See
    %% bench/symbolic_bench.erl and docs/benchmarking.md. Run via:
    %%   rebar3 as bench shell --eval 'symbolic_bench:run(), init:stop().'
    {bench, [
        {deps, [{erlperf, "2.3.0"}]},
        {extra_src_dirs, ["bench"]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_opts, [verbose]}.
