#!/usr/bin/env sh
# The `symbolic` CLI runs directly against on-disk ebin/priv directories,
# not relx's generated node-management script (whose `eval`/`escript`
# commands RPC into a running node). In a release, use its real `lib/`;
# from a source checkout, use the requested rebar3 build profile.
# See docs/cli-erlang.md §1/§1.1.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$LINK_DIR/$SOURCE" ;;
    esac
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ -d "$DIR/lib" ]; then
    LIB_DIR="$DIR/lib"
else
    PROFILE="${REBAR_PROFILE:-default}"
    if [ -d "$DIR/_build/$PROFILE/lib" ]; then
        LIB_DIR="$DIR/_build/$PROFILE/lib"
    elif [ -d "$DIR/_build/default/lib" ]; then
        LIB_DIR="$DIR/_build/default/lib"
    elif [ -d "$DIR/_build/test/lib" ]; then
        LIB_DIR="$DIR/_build/test/lib"
    else
        printf '%s\n' "symbolic: compiled modules not found; run rebar3 compile or rebar3 release first" >&2
        exit 127
    fi
fi

# Keep VM crash dumps out of whichever project directory invoked the CLI.
# Respect an explicit caller override; otherwise use a private per-user path.
if [ -z "${ERL_CRASH_DUMP:-}" ] && [ -n "${HOME:-}" ]; then
    CRASH_DIR="$HOME/.symbolic"
    if mkdir -p "$CRASH_DIR" 2>/dev/null; then
        ERL_CRASH_DUMP="$CRASH_DIR/erl_crash.dump"
        export ERL_CRASH_DUMP
    fi
fi

FOUND_EBIN=false
for APP_EBIN in "$LIB_DIR"/*/ebin; do
    if [ -d "$APP_EBIN" ]; then
        FOUND_EBIN=true
        break
    fi
done
if [ "$FOUND_EBIN" != true ]; then
    printf '%s\n' "symbolic: no Erlang ebin directories found under $LIB_DIR" >&2
    exit 127
fi

# `erl` cannot log its own SIGKILL. Keep an external parent for parse so
# an OS-terminated VM has an exit record beside the CLI phase log. Other
# commands retain exec and their original process/signal behavior.
if [ "${1:-}" = parse ]; then
    if [ -z "${SYMBOLIC_PARSE_LOG:-}" ]; then
        case "$(uname -s)" in
            Darwin) SYMBOLIC_PARSE_LOG="${HOME}/Library/Logs/symbolic/parse.log" ;;
            *) SYMBOLIC_PARSE_LOG="${XDG_STATE_HOME:-${HOME}/.local/state}/symbolic/parse.log" ;;
        esac
    fi
    export SYMBOLIC_PARSE_LOG
    LOG_DIR=$(dirname "$SYMBOLIC_PARSE_LOG")
    if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
        printf 'symbolic: cannot create parse log directory: %s\n' "$LOG_DIR" >&2
    fi
    erl -pa "$LIB_DIR"/*/ebin \
        -noshell \
        -eval "symbolic_cli:main(init:get_plain_arguments()), halt()." \
        -extra "$@" &
    CHILD=$!
    # RSS is an OS measurement; erlang:memory/0 excludes native NIF memory.
    # Keep sampling outside the VM so the final recorded sample survives it.
    (
        while kill -0 "$CHILD" 2>/dev/null; do
            RSS=$(ps -o rss= -p "$CHILD" 2>/dev/null | tr -d ' ')
            if [ -n "$RSS" ]; then
                printf '%s parse: pid=%s rss_kb=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$CHILD" "$RSS" >> "$SYMBOLIC_PARSE_LOG" 2>/dev/null || :
            fi
            sleep 5
        done
    ) &
    SAMPLER=$!
    wait "$CHILD"
    RC=$?
    kill "$SAMPLER" 2>/dev/null || :
    SIGNAL=none
    if [ "$RC" -eq 137 ]; then SIGNAL=SIGKILL; fi
    printf '%s parse: pid=%s exit_status=%s signal=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$CHILD" "$RC" "$SIGNAL" >> "$SYMBOLIC_PARSE_LOG" 2>/dev/null || \
        printf 'symbolic: cannot write parse log: %s\n' "$SYMBOLIC_PARSE_LOG" >&2
    exit "$RC"
fi

exec erl -pa "$LIB_DIR"/*/ebin \
    -noshell \
    -eval "symbolic_cli:main(init:get_plain_arguments()), halt()." \
    -extra "$@"
