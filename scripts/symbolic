#!/usr/bin/env sh
# The `symbolic` CLI runs directly against on-disk ebin/priv directories,
# not relx's generated node-management script (whose `eval`/`escript`
# commands RPC into a running node). In a release, use its real `lib/`;
# from a source checkout, use the requested rebar3 build profile.
# See docs/cli-erlang.md §1/§1.1.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$LINK_DIR/$SOURCE" ;;
    esac
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ -d "$DIR/lib" ]; then
    LIB_DIR="$DIR/lib"
else
    PROFILE="${REBAR_PROFILE:-default}"
    if [ -d "$DIR/_build/$PROFILE/lib" ]; then
        LIB_DIR="$DIR/_build/$PROFILE/lib"
    elif [ -d "$DIR/_build/default/lib" ]; then
        LIB_DIR="$DIR/_build/default/lib"
    elif [ -d "$DIR/_build/test/lib" ]; then
        LIB_DIR="$DIR/_build/test/lib"
    else
        printf '%s\n' "symbolic: compiled modules not found; run rebar3 compile or rebar3 release first" >&2
        exit 127
    fi
fi

# Keep VM crash dumps out of whichever project directory invoked the CLI.
# Respect an explicit caller override; otherwise use a private per-user path.
if [ -z "${ERL_CRASH_DUMP:-}" ] && [ -n "${HOME:-}" ]; then
    CRASH_DIR="$HOME/.symbolic"
    if mkdir -p "$CRASH_DIR" 2>/dev/null; then
        ERL_CRASH_DUMP="$CRASH_DIR/erl_crash.dump"
        export ERL_CRASH_DUMP
    fi
fi

FOUND_EBIN=false
for APP_EBIN in "$LIB_DIR"/*/ebin; do
    if [ -d "$APP_EBIN" ]; then
        FOUND_EBIN=true
        break
    fi
done
if [ "$FOUND_EBIN" != true ]; then
    printf '%s\n' "symbolic: no Erlang ebin directories found under $LIB_DIR" >&2
    exit 127
fi

exec erl -pa "$LIB_DIR"/*/ebin \
    -noshell \
    -eval "symbolic_cli:main(init:get_plain_arguments()), halt()." \
    -extra "$@"
